{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "docs",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/*.md",
      "**/*.tsx",
      "README.md",
      "superpowers/**",
      "plans/**",
      "brainstorms/**",
      "ideation/**",
      "gemini_vorlage/**",
      "play-data-safety.md",
      "oberflaechen-richtlinien.md"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
